{
  "uid": "mecaniqa-erros",
  "title": "MecaniQA - Erros",
  "tags": ["mecaniqa", "oat2"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Taxa de erros (%)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "100 * sum(rate(mecaniqa_sensor_errors_total{job=\"iot-simulator\"}[1m])) / clamp_min(sum(rate(mecaniqa_sensor_readings_total{job=\"iot-simulator\"}[1m])), 0.000001)",
          "legendFormat": "Erros (%)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ]
}
